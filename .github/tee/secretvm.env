# SecretVM artifact configuration for RTMR3 (Intel TDX) + SEV measurement (AMD SEV-SNP)
# Update these when the SecretVM portal's Production artifacts version changes.
#
# Registries (MRTD/RTMR0-2 + SEV kernel/initrd/ovmf hashes):
#   Source repo: https://github.com/scrtlabs/secretvm-verify (node/data/)
#     npm:  https://www.npmjs.com/package/secretvm-verify
#     PyPI: https://pypi.org/project/secretvm-verify/
#   npm secretvm-verify@0.13.0 (published 2026-07-21) stops at TDX v0.0.34 and
#   SEV v0.0.33. v0.0.35 landed on GitHub on 2026-09-17 and was not republished
#   (package.json on that commit still says 0.13.0). Pin the GitHub commit via
#   jsDelivr until a newer npm release includes prod/v0.0.35.
#
# Rootfs ISO digests:
#   SOURCE OF TRUTH for the release to pin is the SecretVM portal's Production
#   "Artifacts version" (what new prod deploys actually run). Cross-check the
#   pin against tdx.csv `rootfs_data` / sev.json `rootfs_hash` for that
#   artifacts_ver. RTMR3 CI uses the pinned SHA-256 directly when the ISO
#   download URL is unavailable (scrtlabs/secret-vm-build releases 404).
#
# IMPORTANT: Always use the "prod" rootfs variant — SecretVM runs "environment prod"
# even for developer portal deployments. Using "dev" rootfs produces wrong measurements.
#
# As of 2026-10 the portal's Production artifacts version is v0.0.35.
# TDX rows for this release cover small/medium/large only (two hosts, one prod rootfs).

SECRETVM_RELEASE=v0.0.35
SECRETVM_ROOTFS_VARIANT=rootfs-prod

# Pin of the secretvm-verify tree that carries tdx.csv / sev.json.
# This is a git sha, not an npm version: 0.13.0 does not contain v0.0.35.
# CI uses the value as the registry cache key.
SECRETVM_VERIFY_NPM_VERSION=a5d0d7c2
SECRETVM_TDX_REGISTRY_URL=https://cdn.jsdelivr.net/gh/scrtlabs/secretvm-verify@a5d0d7c21cceef8305dbbb0589cf10dabe7a2047/node/data/tdx.csv
SECRETVM_SEV_REGISTRY_URL=https://cdn.jsdelivr.net/gh/scrtlabs/secretvm-verify@a5d0d7c21cceef8305dbbb0589cf10dabe7a2047/node/data/sev.json
SECRETVM_SEV_REGISTRY_VM_TYPE=prod

# Intel TDX rootfs (non-GPU, prod — used for proxy-router P-Node deployments)
# Optional download URL (legacy GitHub releases; currently 404). CI falls back to
# SECRETVM_ROOTFS_TDX_SHA256 for RTMR3 when the URL is unreachable.
# SHA-256 is tdx.csv rootfs_data for vm_type=prod, artifacts_ver=v0.0.35
# (identical on every prod template/host row).
SECRETVM_ROOTFS_TDX_URL=https://github.com/scrtlabs/secret-vm-build/releases/download/v0.0.35/rootfs-prod-v0.0.35-tdx.iso
SECRETVM_ROOTFS_TDX_SHA256=bfde9932eb037397fad42f50677c5d1045287369ce3b768560acc0c1a5224f4f

# AMD SEV-SNP rootfs (prod) — same compose, different platform binary
# Optional download URL (legacy). SEV measurement uses registry rootfs_hash + pin.
# SHA-256 is sev.json rootfs_hash for vm_type=prod, artifacts_ver=v0.0.35.
SECRETVM_ROOTFS_SEV_URL=https://github.com/scrtlabs/secret-vm-build/releases/download/v0.0.35/rootfs-prod-v0.0.35-sev.iso
SECRETVM_ROOTFS_SEV_SHA256=893fc9fde55aa21e6b0fad3c60031517f98165c6993b74a94e68eba1fba02950

# GPU variant (for co-located proxy+LLM deployments)
# SECRETVM_ROOTFS_GPU_TDX_URL=https://github.com/scrtlabs/secret-vm-build/releases/download/v0.0.35/rootfs-gpu-prod-v0.0.35-tdx.iso
# SECRETVM_ROOTFS_GPU_TDX_SHA256=
