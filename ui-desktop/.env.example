# Copy to `.env` in this directory before running `yarn dev` or `yarn build`.
#
#   cp .env.example .env
#
# electron.vite.config.ts validates this against env.schema.ts at config-load
# time and throws if anything is missing or malformed, so the build fails fast
# rather than producing a subtly broken app.
#
# Note for anyone editing: an EMPTY value is not the same as an absent one.
# `SENTRY_DSN=` is present-but-empty, which fails the `uri` format check;
# `FAILOVER_ENABLED=` fails the boolean check. Comment the line out instead of
# blanking it. (The previous version of this file had exactly those two bugs,
# plus a missing NODE_ENV, so copying it verbatim would not build.)

# ---------------------------------------------------------------------------
# Network — BASE Mainnet
# ---------------------------------------------------------------------------
CHAIN_ID=8453
CHAIN_NAME=Base
DIAMOND_ADDRESS=0x6aBE1d282f72B474E54527D93b979A4f64d3030a
TOKEN_ADDRESS=0x7431ada8a591c955a994a21710752ef9b882b8e3
EXPLORER_URL=https://basescan.org/tx/{{hash}}
BLOCKSCOUT_API_URL=https://base.blockscout.com/api/v2

# ---------------------------------------------------------------------------
# Network — BASE Sepolia (testnet). Comment out the mainnet block above first.
# ---------------------------------------------------------------------------
#CHAIN_ID=84532
#CHAIN_NAME=Base Sepolia
#DIAMOND_ADDRESS=0xA328196f2438DADA5ab729E39388D86896c27c85
#TOKEN_ADDRESS=0x5C80Ddd187054E1E4aBBfFCD750498e81d34FfA3
#EXPLORER_URL=https://sepolia.basescan.org/tx/{{hash}}
#BLOCKSCOUT_API_URL=https://base-sepolia.blockscout.com/api/v2

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Required, no default. One of: development | production
NODE_ENV=development

# One of: error | warn | info | verbose | debug | silly
LOG_LEVEL=info

DEV_TOOLS=false
DEBUG=false
BYPASS_AUTH=false
FAILOVER_ENABLED=true

# ---------------------------------------------------------------------------
# Optional. Leave these COMMENTED OUT rather than empty — see the note above.
# ---------------------------------------------------------------------------
#SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#TRACKING_ID=

# ---------------------------------------------------------------------------
# Service ports. Defaults shown; uncomment only to override.
# ---------------------------------------------------------------------------
#SERVICE_PROXY_API_PORT=8082
#SERVICE_PROXY_PORT=3333
#SERVICE_IPFS_API_PORT=5001
#SERVICE_AI_API_PORT=3434
